# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_APP=app.py
FLASK_ENV=development

# Database
# SQLite for local development, PostgreSQL for persistent deployments.
# Render/Railway URLs like postgres://... are normalized automatically.
DATABASE_URL=sqlite:///la_condesa.db

# Email Configuration (SMTP for production)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Admin Credentials (for init_db.py)
ADMIN_EMAIL=admin@lacondesa.com
ADMIN_PASSWORD=Admin123!

# Session Configuration
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true

# Fiscal configuration (IVA)
TAX_RATE=0.16

# Cart
CART_TTL_MINUTES=60

# Account verification and password recovery
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_MAX_AGE=86400
PASSWORD_RESET_MAX_AGE=3600

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_STORAGE_URI=memory://

# Payment receipt storage: local (default) or s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=receipts
